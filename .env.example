# ─── Lasso Voice — environment ───────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Public base URL Twilio dials back into (ngrok locally, prod URL deployed).
# Used to build the <Stream> wss:// URL in /twiml.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# ─── Twilio (telephony) ──────────────────────────────────────────────────────
# Upgrade via twil.io/yc-hack. FROM_NUMBER is the purchased Twilio number (E.164).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Primary: NVIDIA Nemotron (sponsor) via an OpenAI-compatible endpoint.
# Falls back to OpenAI GPT-4.1 if Nemotron creds absent.
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b
OPENAI_API_KEY=

# ─── STT / TTS ───────────────────────────────────────────────────────────────
# Defaults: Deepgram STT + Cartesia TTS (reliable). Swap to Gradium for sponsor credit.
# Gradium is the PRIMARY voice provider (sponsor) — does both STT and TTS.
# If GRADIUM_API_KEY is set, the bot uses Gradium for both; Deepgram/Cartesia are fallback.
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ─── Cekura (the learning signal) ────────────────────────────────────────────
# Eval-to-improve: simulates abandoning shoppers throwing objections, scores the agent.
# If absent, the loop runs against the built-in LLM-judge fallback (clearly labeled).
CEKURA_API_KEY=

# ─── Supabase (data) ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
